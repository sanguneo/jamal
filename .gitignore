# _generated policy: approved *_pb2.py and source schemas are tracked at T08.
# Only compiler/build intermediates are ignored, never the whole directory.
src/jamal/_generated/*.pyc
src/jamal/_generated/*.pyo
src/jamal/_generated/*.tmp
